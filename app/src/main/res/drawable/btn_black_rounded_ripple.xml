<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@android:color/white"> <!-- ripple highlight color -->

    <!-- Background Shape -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#020202"/>  <!-- black background -->
            <corners android:radius="28dp"/>  <!-- rounded corners -->
            <padding
                android:left="16dp"
                android:top="10dp"
                android:right="16dp"
                android:bottom="10dp"/>
        </shape>
    </item>

    <!-- Mask (defines ripple area) -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/> <!-- must be opaque -->
            <corners android:radius="28dp"/>   <!-- same radius -->
        </shape>
    </item>
</ripple>