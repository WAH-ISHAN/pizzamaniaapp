<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF"> <!-- subtle white ripple (alpha) -->

    <!-- normal background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>         <!-- black -->
            <corners android:radius="28dp"/>         <!-- rounded corners -->
            <padding
                android:left="16dp"
                android:top="10dp"
                android:right="16dp"
                android:bottom="10dp"/>
        </shape>
    </item>

    <!-- optional pressed overlay (semi-transparent white) -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#80FFFFFF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</ripple>
