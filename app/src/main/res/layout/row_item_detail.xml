<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pizza_new"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/arrowback"
            android:contentDescription="Back" />

        <!-- Pizza Image -->
        <ImageView
            android:id="@+id/ivPizza"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:contentDescription="Pizza Image" />

        <!-- Pizza Name -->
        <TextView
            android:id="@+id/tvPizzaName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pizza Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="6dp"
            android:text="Description..."
            android:textColor="@color/black"
            android:textSize="14sp" />

        <!-- Quantity Selector -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="49dp"
                android:layout_height="40dp"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/black"
                app:cornerRadius="8dp"
                app:rippleColor="@color/white" />

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="1"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="49dp"
                android:layout_height="40dp"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/black"
                app:cornerRadius="8dp"
                app:rippleColor="@color/white" />
        </LinearLayout>

        <!-- Price -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rs. 0.00"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginTop="16dp" />

        <!-- Toppings Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Toppings"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/black" />

        <!-- ✅ This is the new TextView that will show toppings list -->
        <TextView
            android:id="@+id/tvToppings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No toppings"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCheese"
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/cheese" />

                <ImageView
                    android:id="@+id/ivMushroom"
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/mushroom" />

                <ImageView
                    android:id="@+id/ivOlives"
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/olives" />

                <ImageView
                    android:id="@+id/ivChicken"
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/chicken" />

                <ImageView
                    android:id="@+id/ivChilli"
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/chilli" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Add To Cart -->
        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add to Cart"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/black" />
    </LinearLayout>
</ScrollView>