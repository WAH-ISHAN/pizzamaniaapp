<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/pizza_new">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Logo -->

        <!-- Title -->

        <ImageView
            android:id="@+id/ivAdminLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Admin Logo"
            android:src="@drawable/propic" />

        <TextView
            android:id="@+id/tvAdminTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Register"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp" />

        <!-- Form Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="449dp"
            android:backgroundTint="@android:color/white"
            android:padding="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="457dp"
                android:background="@drawable/pizza_new"
                android:orientation="vertical">

                <!-- Branch Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Branch">

                    <AutoCompleteTextView
                        android:id="@+id/etAdminBranch"
                        android:layout_width="match_parent"
                        android:layout_height="41dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/transparent"
                        android:cursorVisible="false"
                        android:entries="@array/branches"
                        android:focusable="false"
                        android:inputType="none"
                        android:text=" Select Branch"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAdminEmail"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/transparent"
                        android:inputType="textEmailAddress"
                        android:text="Branch Email"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <TextView
                    android:id="@+id/tvAdminLogin2"
                    android:layout_width="239dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter Password"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="Password"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAdminPassword"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_marginTop="0dp"
                        android:background="@color/transparent"
                        android:inputType="textPassword" />


                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvAdminLogin5"
                    android:layout_width="187dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Comfirm Password"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <!-- Confirm Password -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:hint="Confirm Password"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAdminConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="0dp"
                        android:background="@color/transparent"
                        android:inputType="textPassword" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Register Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminRegister"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/btn_black_rounded_ripple"
                    android:text="Register as Admin"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:cornerRadius="25dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Already have account -->
        <TextView
            android:id="@+id/tvAdminLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="dp"
            android:text="Already have an account? Login"
            android:textColor="@color/black"
            android:textSize="14sp" />



    </LinearLayout>
</ScrollView>
