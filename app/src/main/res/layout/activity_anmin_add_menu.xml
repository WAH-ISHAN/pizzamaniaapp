<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/pizza_new">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvWelcomeAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Add Menu"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Branch Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Branch"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/text_round_bg"
            android:padding="12dp" />

        <!-- Menu Item Fields -->
        <LinearLayout
            android:id="@+id/menuItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:divider="?android:dividerHorizontal"
            android:showDividers="middle"
            android:paddingBottom="20dp">

            <!-- Food Image -->
            <ImageView
                android:id="@+id/ivAdminProfile"
                android:layout_width="191dp"
                android:layout_height="177dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/cheesepizza"
                android:contentDescription="Pizza pic"
                android:padding="8dp" />

            <!-- Food Name -->
            <TextView
                android:id="@+id/textViewFoodName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/text_round_bg"
                android:padding="10dp"
                android:text="Food Name"
                android:textAlignment="center"
                android:textColor="@color/black" />

            <!-- Description -->
            <TextView
                android:id="@+id/textViewDescription"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/text_round_bg"
                android:padding="10dp"
                android:text="Description"
                android:textAlignment="center"
                android:textColor="@color/black" />

            <!-- Price -->
            <TextView
                android:id="@+id/textViewPrice"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/text_round_bg"
                android:padding="10dp"
                android:text="Price"
                android:textAlignment="center"
                android:textColor="@color/black" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMenuItem"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_black_rounded_ripple"
                android:text="Update"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="25dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_black_rounded_ripple"
                android:text="Remove"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="25dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
