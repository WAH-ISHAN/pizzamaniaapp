<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/pizza_new"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBackDashboard"
            android:layout_width="36dp"
            android:layout_height="35dp"
            android:background="@drawable/arrowback"
            android:contentDescription="Back" />

        <!-- Admin Menu Title -->
        <TextView
            android:id="@+id/tvWelcomeAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Add / Manage Menu"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/menuItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_white_card"
            android:layout_marginTop="12dp"
            android:padding="16dp">

            <!-- Food Image -->
            <ImageView
                android:id="@+id/ivAdminFood"
                android:layout_width="127dp"
                android:layout_height="97dp"
                android:layout_gravity="center"
                android:background="@drawable/cheesepizza"
                android:contentDescription="Food Image"
                android:scaleType="centerCrop" />

            <!-- Choose Image Button -->
            <Button
                android:id="@+id/btnChooseImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Choose Image"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/black" />

            <!-- Branch Selector -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Branch">

                <AutoCompleteTextView
                    android:id="@+id/etAdminBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:background="@drawable/text_round_bg"
                    android:textColor="@color/black"
                    android:focusable="true"
                    android:clickable="true"
                    android:cursorVisible="false"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Food Name -->
            <EditText
                android:id="@+id/etFoodName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/text_round_bg"
                android:hint="Food Name"
                android:padding="10dp"
                android:textColor="@color/black" />

            <!-- Description -->
            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Description"
                android:background="@drawable/text_round_bg"
                android:minLines="3"
                android:gravity="top|start"
                android:padding="10dp"
                android:textColor="@color/black" />

            <!-- Price -->
            <EditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Price (Rs.)"
                android:background="@drawable/text_round_bg"
                android:padding="10dp"
                android:inputType="numberDecimal"
                android:textColor="@color/black" />

            <!-- Toppings Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Toppings"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black" />

            <!-- ✅ Use ChipGroup for dynamic toppings -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/toppingsContainer"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="8dp"
                app:chipSpacing="8dp"
                app:singleLine="false"
                app:singleSelection="false" />

            <!-- Add Topping Button -->
            <Button
                android:id="@+id/btnAddTopping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Add New Topping"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/black" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMenuItem"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_black_rounded_ripple"
                android:text="ADD"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="25dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRemoveMenuItem"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_black_rounded_ripple"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="25dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>