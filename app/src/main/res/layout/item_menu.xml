<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/pizza_new">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPopular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/text_round_bg"
                android:text="Popular Pizza"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:textColor="@color/orange"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Category Tabs -->
        <LinearLayout
            android:layout_width="385dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/text_round_bg"
                android:text="All Pizzas"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/text_round_bg"
                android:text="Vegetarian"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/text_round_bg"
                android:text="Specials"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="392dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/text_round_bg"
            android:drawableStart="@drawable/baseline_search_24"
            android:drawablePadding="8dp"
            android:hint="Search your favourite pizza"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <!-- Special Offer Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            android:background="@color/transparent"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvOfferTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Special Offer"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOrderNow"
                    android:layout_width="140dp"
                    android:layout_height="38dp"
                    android:layout_below="@id/tvOfferDesc"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_black_rounded_ripple"
                    android:text="Order Now"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/ivOfferPizza"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/pizzaoffer"
                    android:contentDescription="Offer Pizza" />

                <TextView
                    android:id="@+id/tvOfferDesc"
                    android:layout_width="152dp"
                    android:layout_height="49dp"
                    android:layout_below="@id/tvOfferTitle"
                    android:layout_marginTop="10dp"
                    android:fontFamily="serif-monospace"
                    android:text="Discount 20% off applied at checkout"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pizza Item 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="101dp"
                    android:layout_height="80dp"
                    android:contentDescription="Pepperoni Pizza"
                    android:src="@drawable/pepperoni_pizza" />

                <LinearLayout
                    android:layout_width="258dp"
                    android:layout_height="82dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="181dp"
                        android:layout_height="wrap_content"
                        android:text="Pepperoni Pizza"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Offer valid today only\n20min"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="79dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="$10.00"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pizza Item 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="103dp"
                    android:layout_height="87dp"
                    android:contentDescription="Margherita Pizza"
                    android:src="@drawable/hotpepperpizza" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="189dp"
                        android:layout_height="wrap_content"
                        android:text="Hot chilli Pizza"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="122dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="2dp"
                        android:text="Offer valid today only\n30min"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="85dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="$8.00"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pizza Item 3 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="105dp"
                    android:layout_height="80dp"
                    android:contentDescription="Pepperoni Pizza"
                    android:src="@drawable/bbq_chickenpizza" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="81dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="167dp"
                        android:layout_height="wrap_content"
                        android:text="BBQ Chicken Pizza"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Offer valid today only\n20min"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="wrap_content"
                            android:text="$10.00"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:layout_marginTop="2dp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recycler to list menu items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:padding="16dp" />

    </LinearLayout>
</ScrollView>