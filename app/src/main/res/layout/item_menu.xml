<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/pizza_new">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">


        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPopular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:background="@drawable/text_round_bg"
                android:text="Popular Pizza"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All"
                android:textColor="@color/orange"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Category Tabs -->
        <LinearLayout
            android:layout_width="385dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginStart="15dp"
                android:background="@drawable/text_round_bg"
                android:text="All Pizzas"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/text_round_bg"
                android:text="Vegetarian"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Button
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/text_round_bg"
                android:text="Specials"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="392dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/text_round_bg"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:hint="Search your favourite pizza"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <!-- Special Offer Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            android:background="@color/transparent"
            app:cardElevation="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvOfferTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Special Offer"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOrderNow"
                    android:layout_width="140dp"
                    android:layout_height="38dp"
                    android:layout_below="@id/tvOfferDesc"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_black_rounded_ripple"
                    android:text="Order Now"
                    android:textColor="@color/white"
                    android:textSize="10dp" />

                <ImageView
                    android:id="@+id/ivOfferPizza"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="40dp"
                    android:background="@drawable/pizzaoffer"
                    android:contentDescription="Offer Pizza" />

                <TextView
                    android:id="@+id/tvOfferDesc"
                    android:layout_width="152dp"
                    android:layout_height="49dp"
                    android:layout_below="@id/tvOfferTitle"
                    android:layout_marginTop="10dp"
                    android:fontFamily="serif-monospace"
                    android:text="Discount 20% off applied at checkout"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pizza Item 1 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Pepperoni Pizza"
                    android:src="@drawable/pizza_pepperoni" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:text="Pepperoni Pizza"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:text="Offer valid today only\n20min"
                        android:textColor="@color/dark_gray"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:text="$10.00"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_marginStart="8dp"
                            android:background="@drawable/discount_bg"
                            android:padding="4dp"
                            android:text="20% Off"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pizza Item 2 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/pizza_margherita"
                    android:contentDescription="Margherita Pizza"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:text="Margherita Pizza"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>

                    <TextView
                        android:text="Offer valid today only\n30min"
                        android:textSize="13sp"
                        android:textColor="@color/dark_gray"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:text="$8.00"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"/>

                        <TextView
                            android:text="10% Off"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/discount_bg"
                            android:padding="4dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/pizza_pepperoni"
                    android:contentDescription="Pepperoni Pizza"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:text="Pepperoni Pizza"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"/>

                    <TextView
                        android:text="Offer valid today only\n20min"
                        android:textSize="13sp"
                        android:textColor="@color/dark_gray"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:text="$10.00"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"/>

                        <TextView
                            android:text="20% Off"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/discount_bg"
                            android:padding="4dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_add"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="Add"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
