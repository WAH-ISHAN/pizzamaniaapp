<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp" android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:background="@drawable/pizza_new"
    android:layout_height="match_parent">


    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif-monospace"
        android:layout_marginTop="10dp"
        android:text="Pizza Mania"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        />


    <ImageView
        android:id="@+id/ivProfile"
        android:layout_width="136dp"
        android:layout_height="138dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/propic"
        android:scaleType="centerCrop" />

    <Button
        android:id="@+id/btnCapture"
        android:layout_width="232dp"
        android:layout_height="46dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/btn_black_rounded_ripple"
        android:text="Capture Profile Photo"
        android:textColor="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="474dp"
        android:layout_marginTop="15dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:background="@color/transparent"
            android:text="Name"
            android:textColor="@color/black"
            android:textSize="18dp" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="1dp"
            android:text="Change password "
            android:textColor="@color/black"
            android:textSize="18dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView17"
            android:layout_width="164dp"
            android:layout_height="30dp"
            android:layout_marginTop="1dp"
            android:text="Current password :"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextTextPassword"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="5dp"
            android:background="@color/transparent"
            android:ems="10"
            android:inputType="textPassword"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/textView17"
            android:layout_width="164dp"
            android:layout_height="30dp"
            android:layout_marginTop="1dp"
            android:text="New password :"
            android:textColor="@color/white"
            android:textSize="18dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextTextPassword2"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="5dp"
            android:background="@color/transparent"

            android:ems="10"
            android:inputType="textPassword"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/textView17"
            android:layout_width="164dp"
            android:layout_height="30dp"
            android:layout_marginTop="1dp"
            android:text="Change Email :"
            android:textColor="@color/black"
            android:textSize="18dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextTextEmailAddress"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="5dp"
            android:background="@color/transparent"
            android:ems="10"
            android:inputType="textEmailAddress" />

        <LinearLayout
            android:id="@+id/socialRow"
            android:layout_width="354dp"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_black_rounded_ripple"
                android:text="Update"
                android:textAllCaps="false"
                android:textColor="@color/white"/>



            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFacebook"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_black_rounded_ripple"
                android:text="Remove Account"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>



    </LinearLayout>

