<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/pizza_bg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="29dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Page Title -->

            <!-- Order ID -->

            <!-- Status -->


            <TextView
                android:id="@+id/textView3"
                android:layout_width="165dp"
                android:layout_height="35dp"
                android:fontFamily="serif-monospace"
                android:text="Pizza Mania"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="24dp"
                android:textStyle="bold"
                tools:layout_editor_absoluteX="88dp"
                tools:layout_editor_absoluteY="-3dp" />

            <TextView
                android:id="@+id/tvOrderTitle"
                android:layout_width="355dp"
                android:layout_height="60dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/rounded_title_bg"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:text="Order Details"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivPizza"
                android:layout_width="149dp"
                android:layout_height="198dp"
                android:layout_marginTop="-20dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Pizza illustration"
                android:elevation="4dp"
                android:src="@drawable/mainimage"
                app:layout_constraintBottom_toBottomOf="@id/tvRegisterTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="@id/tvRegisterTitle"
                app:layout_constraintTop_toTopOf="@id/tvRegisterTitle"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/tvId"
                android:layout_width="332dp"
                android:layout_height="35dp"
                android:layout_marginTop="180dp"
                android:background="@drawable/text_round_bg"
                android:text="Order ID: "
                android:textColor="@color/grey"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="332dp"
                android:layout_height="35dp"
                android:background="@drawable/text_round_bg"
                android:text="Status: "
                android:textColor="@color/grey"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvId" />

            <!-- Branch -->
            <TextView
                android:id="@+id/tvBranch"
                android:layout_width="332dp"
                android:layout_height="35dp"
                android:text="Branch: "
                android:textSize="16sp"
                android:textColor="@color/grey"
                android:textAlignment="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/text_round_bg"

                app:layout_constraintTop_toBottomOf="@id/tvStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Address -->
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="332dp"
                android:layout_height="35dp"
                android:text="Address: "
                android:textSize="16sp"
                android:textColor="@color/grey"
                android:textAlignment="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/text_round_bg"
                app:layout_constraintTop_toBottomOf="@id/tvBranch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Payment -->
            <TextView
                android:id="@+id/tvPayment"
                android:layout_width="332dp"
                android:layout_height="35dp"
                android:text="Payment: "
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:background="@drawable/text_round_bg"
                android:textAlignment="center"
                android:textColor="@color/grey"
                app:layout_constraintTop_toBottomOf="@id/tvAddress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Total -->
            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="332dp"
                android:layout_height="35dp"
                android:layout_marginTop="10dp"
                android:text="Total: Rs. 0.00"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:textAlignment=""
                app:layout_constraintTop_toBottomOf="@id/tvPayment"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Created -->
            <TextView
                android:id="@+id/tvCreated"
                android:layout_width="332dp"
                android:layout_height="35dp"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="10dp"
                android:text="Created: "
                android:textAlignment="center"
                android:textSize="16sp"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/tvTotal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- RecyclerView for items -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="348dp"
                android:layout_height="168dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCreated"
                app:layout_constraintVertical_bias="1.0" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</ScrollView>
