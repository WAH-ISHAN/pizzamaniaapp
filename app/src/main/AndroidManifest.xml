<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET required for Firebase / APIs -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location access -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Camera access -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Media / Storage access -->
    <!-- For Android 13+ scoped storage images -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- For Android <=12 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".app.PizzaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PizzaMania">

        <!-- Launcher / Main -->
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.auth.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Profile Activity -->
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.auth.ActivityProfile"
            android:exported="false" />

        <!-- Menu Details (internal navigation) -->
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.menu.ItemDetailActivity"
            android:exported="true" />

        <!-- Login Screen -->
        <activity
            android:name="com.example.pizzamaniaapp.ui.LoginActivity"
            android:exported="true" />

        <!-- Register Screen -->
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.auth.RegisterActivity"
            android:exported="true" />

        <!-- Admin Dashboard -->
        <activity
            android:name="com.example.pizzamaniaapp.ui.admin.AdminDashboardActivity"
            android:exported="true" />
        <activity
            android:name="com.example.pizzamaniaapp.ui.admin.AdminAddMenuActivity"
            android:exported="true" />
        <activity
            android:name="com.example.pizzamaniaapp.ui.admin.AdminRegisterActivity"
            android:exported="true" />

        <!-- Home -->
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.home.HomeActivity"
            android:exported="true" />
        <!-- map -->
        <activity
            android:name=".app.ui.map.BranchMapActivity"
            android:exported="true" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <!-- Menu List -->
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.menu.MenuListActivity"
            android:exported="true" />

        <!-- Order related activities -->
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.order.PlaceOrderActivity"
            android:exported="true" />
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.order.AdminOrdersActivity"
            android:exported="true" />
        <activity
            android:name="com.example.pizzamaniaapp.app.ui.cart.CartActivity"
            android:exported="true" />

        <!-- FileProvider: Required for Camera / Sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
